config routebot
	option fwmask '0xff000000'	# routebot's slice of the fwmark
	option table_id '10000'		# CIDR table; interface tables are table_id + idx
	option iface_prio '10000'	# interface rules are iface_prio + idx
	option rule_prio '20000'	# "fwmark 0/fwmask lookup table_id"
	option gw_table 'main'		# where gateways are learned from
	option rt_proto '233'		# protocol tag on everything routebot owns

# idx is the 1-based position among interface sections.
# The section name is the Linux device unless 'option device' says otherwise.
# Without a fwmark the interface only serves as a target for rules.
# Gateways are learned from default routes in gw_table; set 'gateway' /
# 'gateway6' to pin one. An interface that is down, or is not point-to-point
# and has no gateway, gets blackhole routes.

#config interface 'vpn_warp'
#	option fwmark '0x12'

#config interface 'wan_pppoe'
#	option device 'pppoe-wan'
#	option fwmark '0xaa'

# cidrset entries are globs; files hold one CIDR per line, '#' comments.
# A CIDR claimed by several rules goes to the first rule in this file.

#config rule 'as13335_warp'
#	option iface 'vpn_warp'
#	list cidrset '/tmp/routebot/as13335.lst'

#config rule 'misc'
#	option iface 'wan_pppoe'
#	list cidrset '/etc/routebot.d/misc/*'
