config routebot
	option fwmask '0xff000000'	# routebot's slice of the fwmark
	option table_id '10000'		# CIDR table; +1 probe table; +1+N group tables
	option rule_prio '10000'	# CIDR rule; +1 probe rule; +1+N group rules
	option gw_table 'main'		# where gateways are learned from
	option rt_proto '233'		# protocol tag on everything routebot owns
	option nexthop_id '10000'	# nexthop ids: from this on (>= 1)
	option probe_mark '0xfe'	# fwmark reserved for health probes
	option buckets '1024'		# resilient group defaults, per-group overridable
	option timer_idle '120'		# s
	option timer_busy '600'		# s, 0 = never force

# N is the 1-based position among group sections.
# A group is a set of devices bundled as an ECMP resilient nexthop group.
# Devices are netifd interface or Linux device names, optionally ':weight'
# (1..256). Without any device, the section name is the device.
# Without a fwmark the group only serves as a target for rules.
# Gateways are learned from default routes in gw_table; on single-device
# groups 'gateway' / 'gateway6' pin one. A member drops out while it is down,
# has no gateway (unless point-to-point) or fails its probes; a group with no
# usable member holds a blackhole: its traffic is dropped.

#config group 'vpn_warp'
#	option fwmark '0x12'

#config group 'wan'
#	option device 'pppoe-wan'
#	option fwmark '0xaa'

#config group 'vpn_mullvad'
#	list device 'vpn_mullvad_se1'
#	list device 'vpn_mullvad_se2:2'
#	option fwmark '0x20'
#	option probe '10.64.0.1'
#	option probe6 'fc00:bbbb:bbbb:bb01::1'
#	option probe_timer '1'	# s, fractions allowed, >= 0.1
#	option probe_count '3'		# losses to drop out, replies to come back

# cidrset entries are globs; files hold one CIDR per line, '#' comments.
# A CIDR claimed by several rules goes to the first rule in this file.

#config rule 'as13335_warp'
#	option group 'vpn_warp'
#	list cidrset '/tmp/routebot/as13335.lst'

#config rule 'misc'
#	option group 'vpn_mullvad'
#	list cidrset '/etc/routebot.d/misc/*'
